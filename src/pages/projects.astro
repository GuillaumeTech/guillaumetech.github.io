---
import AnimatedLink from "../components/AnimatedLink.astro";
import BodyText from "../components/BodyText.astro";
import Cell from "../components/Cell.astro";
import Greetings from "../components/Greetings.astro";
import Grid from "../components/Grid.astro";
import Header from "../components/Header.astro";
import Logo from "../components/Logo.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Header>
    <Logo />
    <Nav />
    <Greetings greeting="Projects, finished and unfinished" />
  </Header>

  <main class="page-content">
    <Grid>
      <Cell>
        <h4>Gatura</h4>
        <BodyText>
          A geometric serif to use for display, currently with 67 glyphs:
          uppercase, lowercase, numbers, and !?-.,
        </BodyText>
        <BodyText>
          <AnimatedLink href="https://github.com/GuillaumeTech/gatura">
            Visit the Gatura repository
          </AnimatedLink>
        </BodyText>
      </Cell>

      <Cell>
        <h4>Onion Soup</h4>
        <BodyText>
          My first font, created to learn the drawing tools. As an introductory
          project, it has a limited set of lowercase glyphs and !?.,
        </BodyText>
        <BodyText>
          <AnimatedLink href="https://github.com/GuillaumeTech/onion-soup">
            Visit the Onion Soup repository
          </AnimatedLink>
        </BodyText>
      </Cell>

      <Cell>
        <h4>RollNest</h4>
        <BodyText>
          A web app for arranging photos on roll paper for fine-art printing,
          with dedicated margin controls and automatic layouts.
        </BodyText>

        <BodyText>
          <AnimatedLink href="https://rollnest.app">
            Visit the RollNest website
          </AnimatedLink>
        </BodyText>
      </Cell>

      <Cell>
        <h4>My Fermentation Notes</h4>
        <BodyText>
          A web app for keeping fermentation notes, with a scoring system.
        </BodyText>
        <BodyText>
          <AnimatedLink href="https://github.com/GuillaumeTech/booch">
            Visit the My Fermentation Notes repository
          </AnimatedLink>
        </BodyText>
      </Cell>

      <Cell>
        <h4>Genesia</h4>
        <BodyText>
          Guided procedural generation of a group of islands.
        </BodyText>
        <BodyText>
          <AnimatedLink href="https://github.com/GuillaumeTech/genesia">
            Visit the Genesia repository
          </AnimatedLink>
        </BodyText>

        <Cell>
          <h4>go3d</h4>
          <BodyText>A basic ray tracer in Go.</BodyText>

          <BodyText>
            <AnimatedLink href="https://github.com/GuillaumeTech/go3d">
              Visit the go3d repository
            </AnimatedLink></BodyText
          >
        </Cell>
      </Cell>

      <Cell>
        <h4>fb-ads-remove</h4>
        <BodyText>
          A browser extension that removes "Sponsored," "Posts You May Like,"
          and "Suggested for You" posts from your Facebook feed.
        </BodyText>
        <BodyText>
          <AnimatedLink href="https://github.com/GuillaumeTech/fb-ads-remove">
            Visit the fb-ads-remove repository
          </AnimatedLink>
        </BodyText>
      </Cell>

      <Cell>
        <h4>iso-svg</h4>
        <BodyText>Trace 3D shapes in isometric SVG.</BodyText>
        <BodyText>
          <AnimatedLink href="https://github.com/GuillaumeTech/isosvg">
            Visit the iso-svg repository
          </AnimatedLink>
        </BodyText>
      </Cell>

      <Cell>
        <h4>frit</h4>
        <BodyText>
          An AI model for named-entity recognition of ingredients in French
          recipes.
        </BodyText>
        <BodyText>
          <AnimatedLink href="https://github.com/GuillaumeTech/frit">
            Visit the frit repository
          </AnimatedLink>
        </BodyText>
      </Cell>

      <Cell>
        <h4>Wikipathfinder</h4>
        <BodyText>
          Finds the shortest path between wiki pages by following links.
        </BodyText>
        <BodyText>
          <AnimatedLink href="https://github.com/GuillaumeTech/wikipathfinder">
            Visit the Wikipathfinder repository
          </AnimatedLink>
        </BodyText>
      </Cell>
    </Grid>
  </main></Layout
>
