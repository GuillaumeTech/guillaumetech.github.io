---
import AnimatedLink from "../components/AnimatedLink.astro";
import BodyText from "../components/BodyText.astro";
import Cell from "../components/Cell.astro";
import Greetings from "../components/Greetings.astro";
import Grid from "../components/Grid.astro";
import Header from "../components/Header.astro";
import Logo from "../components/Logo.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Header>
    <Logo />
    <Nav />
    <Greetings greeting="Projects, finished and unfinished" />
  </Header>

  <main class="page-content">
    <Grid>
      <Cell>
        <h4>Gatura</h4>
        <BodyText>
          A geometric serif to use for display, currently with 67 glyphs:
          uppercase, lowercase, numbers and !?-.,
        </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/gatura">
          Go to Gatura repo
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>Onion Soup</h4>
        <BodyText>
          A first font I made to learn the drawing tools. As an introduction
          project it has limited set of glyphs lowercase and !?.,
        </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/onion-soup">
          Go to Onion Soup repo
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>RollNest</h4>
        <BodyText>
          Web-app to arrange photos on roll paper for fine art printing.
          Dedicated controls for margins, and automatic layouts.
        </BodyText>

        <AnimatedLink href="https://rollnest.app">
          Go to RollNest website
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>My Fermentation notes</h4>
        <BodyText>
          Web-app to keep notes on Fermentation with a scoring system
        </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/booch">
          Go to My Fermentation notes repo
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>Genesia</h4>
        <BodyText>
          Guided procedural generation of a bunch of islands.
        </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/genesia">
          Go to Genesia repo
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>go3d</h4>
        <BodyText> Basic raytracer in go </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/go3d">
          Go to go3d repo
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>fb-ads-remove</h4>
        <BodyText>
          Extension to remove "sponsored ", "post you may like" and "suggested
          for you" posts, from your facebook feed.
        </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/fb-ads-remove">
          Go to fb-ads-remove repo
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>iso-svg</h4>
        <BodyText> Trace 3d shapes in isometric svg </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/isosvg">
          Go to iso-svg repo
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>frit</h4>
        <BodyText>
          AI model for named entity recognition of ingredients in french recipes
        </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/frit">
          Go to frit repo
        </AnimatedLink>
      </Cell>

      <Cell>
        <h4>Wikipathfinder</h4>
        <BodyText>
          Find the shortest path (jumps to other pages linked) between wiki
          pages
        </BodyText>
        <AnimatedLink href="https://github.com/GuillaumeTech/wikipathfinder">
          Go to Wikipathfinder repo
        </AnimatedLink>
      </Cell>
    </Grid>
  </main>
</Layout>
