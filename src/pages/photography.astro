---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import Grid from "../components/Grid.astro";
import Cell from "../components/Cell.astro";
import BodyText from "../components/BodyText.astro";
import Greetings from "../components/Greetings.astro";
import Logo from "../components/Logo.astro";
import Nav from "../components/Nav.astro";
import ImageCell from "../components/ImageCell.astro";
import AnimatedLink from "../components/AnimatedLink.astro";
---

<Layout>
  <Header>
    <Logo />
    <Nav />
    <Greetings greeting="Photos, and other visual venture" />
  </Header>

  <main class="page-content">
    <Grid>
      <Cell width={3}>
        <h4>Selected works</h4>
        <BodyText>
          Here is a small selection of my favorite pictures. Mostly, My interest
          in photography has been shapes and textures, and how they interact.
          Recently I've embraced black and white, as I find it really lets those
          elements shine. The better way to get an idea of the kind of
          photography I do is to simply have a lookaround. The photos will speak
          for themselves.
        </BodyText>

        <BodyText>
          I also sell prints, and I plan to add a shop here eventually. Until
          then, if you're interested in a print, or if you'd like to use one of
          these photos, just send me a message on <AnimatedLink
            href="https://www.instagram.com/guillaume_tech/"
            >Instagram</AnimatedLink
          >.
        </BodyText>
      </Cell>
      <ImageCell
        imageName="sapin"
        alt="a car near a port with a boat in the background"
        loading="eager"
        spanV={2}
      />

      <ImageCell
