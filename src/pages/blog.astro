---
import BodyText from "../components/BodyText.astro";
import Cell from "../components/Cell.astro";
import Greetings from "../components/Greetings.astro";
import Grid from "../components/Grid.astro";
import Header from "../components/Header.astro";
import Logo from "../components/Logo.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";

interface BlogPost {
	url: string;
	frontmatter: { title: string; intro: string };
}
const posts: BlogPost[] = Object.values(
	import.meta.glob("./posts/*.md", { eager: true }),
);
---

<Layout>
  <Header>
    <Logo />
    <Nav />
    <Greetings greeting="Thoughts & Ideas" />
  </Header>

  <main class="page-content">
    <Grid>
      {
        posts.map((post: BlogPost) => (
          <a href={post.url}>
            <Cell>
              <h4>{post.frontmatter.title}</h4>
              <BodyText>{post.frontmatter.intro}</BodyText>
            </Cell>
          </a>
        ))
      }
    </Grid>
  </main>
</Layout>

<style>
  .page-content {
    a {
      color: var(--primary-text-color);
      text-decoration: none;
    }
  }

  :global(body) {
    --background-color: var(--background-color-blog);
    --accent-color: var(--accent-color-blog);
  }
</style>
