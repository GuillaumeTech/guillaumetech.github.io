---
interface Props {
	href?: string;
	target?: string;
}
const { href, target = "_blank" } = Astro.props;
---

<a class="base-link" rel="noopener noreferrer" href={href} target={target}
  ><slot /></a
>

<style>
  .base-link {
    font-weight: 600;
    position: relative;
    clip-path: inset(-5px 0);
  }

  .base-link:hover {
    color: var(--primary-text-color);
    transition: color 250ms ease-in-out;
  }

  .base-link::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 250%;
    height: 1px;
    background: linear-gradient(
      to right,
      var(--accent-color),
      var(--accent-color) 50%,
      var(--secondary-text-color) 50%,
      var(--secondary-text-color)
    );
    transition: transform 250ms ease-in-out;
    transform: translate3d(-50%, 0, 0);
  }

  .base-link:hover::after {
    transform: translate3d(0, 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
