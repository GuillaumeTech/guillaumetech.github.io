---
interface Props {
  lineClamp?: number;
}
const { lineClamp = 0 } = Astro.props;

const textClass = lineClamp === 0 ? "" : "clamp";
---

<p class={textClass}>
  <slot />
</p>

<style define:vars={{ lineClamp }}>
  p {
    color: var(--secondary-text-color);
    font-size: 16px;
    line-height: 140%;
  }
  .clamp {
    display: -webkit-box;
    -webkit-line-clamp: var(--lineClamp);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
