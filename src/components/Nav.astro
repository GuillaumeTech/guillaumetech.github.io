---
const pathname = Astro.url.pathname;

const links = [
	{ href: "/about", label: "About" },
	{ href: "/projects", label: "Projects" },
	{ href: "/photography", label: "Photography & other mediums" },
	{ href: "/blog", label: "Blog" },
	{ href: "/resume", label: "Resume" },
];
---

<nav class="nav" aria-label="Main navigation">
  {
    links.map(({ href, label }) => {
      const isActive = pathname === href || pathname.startsWith(href + "/");
      return (
        <a
          href={href}
          class:list={["nav-link", { active: isActive }]}
          aria-current={isActive ? "page" : undefined}
        >
          {label}
        </a>
      );
    })
  }
</nav>

<style>
  .nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 8px;
    grid-area: nav;
  }

  .nav-link {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--primary-text-color);
    text-decoration: none;
    padding: 10px 0;
    position: relative;
  }


  .nav-link:nth-child(1) { --link-accent: var(--accent-color-about); }
  .nav-link:nth-child(2) { --link-accent: var(--accent-color-projects); }
  .nav-link:nth-child(3) { --link-accent: var(--accent-color-photography); }
  .nav-link:nth-child(4) { --link-accent: var(--accent-color-blog); }
  .nav-link:nth-child(5) { --link-accent: var(--accent-color-resume); }

  .nav-link::before {
    content: "";
    position: absolute;
    bottom: 8px;
    left: -20px;
    width: 12px;
    height: 0rem;
    background-color: var(--link-accent);
    transition: height 150ms ease-in-out;
  }

  .nav-link:hover::before,
  .nav-link.active::before {
    height: 1.7rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::before {
      transition: none;
    }
  }
</style>
