---
import Logo from "./Logo.astro";
import { PAGE_COLORS } from "../colors";

const blogAccent = PAGE_COLORS["/blog"].accent;
---

<header class="site-header">
  <Logo />
  <div class="separator" style={`background: ${blogAccent};`}></div>
  <div class="subsection">
    <!-- only used for blog, add props when needed-->
    <a class="base-link" href="/blog">Blog</a>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    gap: 1.2rem;
    padding-top: 100px;
    padding-bottom: 70px;
    align-items: baseline;
  }

  .separator {
    position: relative;
    width: 12px;
    height: 1.7rem;

    align-self: center;
  }

  .subsection {
    font-size: 1.2rem;
    color: var(--primary-text-color);
  }

  @media (max-width: 1000px) {
    .site-header {
      padding-top: 60px;
    }
  }

  @media (max-width: 600px) {
    .site-header {
      padding: 24px 0;
    }
  }
</style>
