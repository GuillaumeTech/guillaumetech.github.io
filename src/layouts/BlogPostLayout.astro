---
const { frontmatter } = Astro.props;
import SmallHeader from "../components/SmallHeader.astro";
import Layout from "./Layout.astro";

const pubDate = new Date(frontmatter.pubDate);

const dateString = pubDate.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout>
  <SmallHeader />
  <article>
    <hr>
    <h1>{frontmatter.title}</h1>
    <p>{frontmatter.intro}</p>
    <p>{dateString}</p>
    <hr>
    <div class="content">
      <slot />
    </div>
  </article>
</Layout>

<!-- global style so the style reach within the slots
 not ideal but also this is only used with blogpost as implied by the name
 so not that bad
-->
<style is:global>
  h1,
  h2,
  h3,
  h4 {
    font-family: "Young Serif", Georgia, serif;
    margin: 1rem 0rem;
    margin-top: 2rem;
  }

  body {
    background: var(--background-color-blog);
  }

   article p {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .content {
    width: 70%;
    max-width: 900px;
    margin-top: 5rem;
    margin-bottom: 5rem;
  }
  @media (max-width: 900px) {
    .content {
      width: 100%;
    }
  }

  pre {
    padding: 1rem;
  }
</style>
