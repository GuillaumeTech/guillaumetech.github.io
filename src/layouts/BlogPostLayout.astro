---
const { frontmatter } = Astro.props;
import SmallHeader from "../components/SmallHeader.astro";
import Layout from "./Layout.astro";

const pubDate = new Date(frontmatter.pubDate);

const dateString = pubDate.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout>
  <SmallHeader />
  <article>
    <hr />
    <p>{dateString}</p>

    <h1>{frontmatter.title}</h1>
    <p>{frontmatter.intro}</p>
    <hr />
    <div class="blog-content">
      <slot />
    </div>
  </article>
</Layout>

<style>
  h1 {
    font-family: "Young Serif", Georgia, serif;
    margin: 1rem 0rem;
    margin-top: 2rem;
  }

  p {
    margin: 2rem 0;
  }

  body {
    background: var(--background-color-blog);
  }
  /* global style so the style reach within the slots
 not ideal but also this is only used with blogpost as implied by the name
 so not that bad */
  :global(.blog-content) {
    h1,
    h2,
    h3,
    h4 {
      margin: 1rem 0rem;
      margin-top: 2rem;
    }

     p {
      margin-top: 0.5rem;
      margin-bottom: 1rem;
    }

    pre {
      padding: 1rem;
    }
  }

  .blog-content {
    width: 70%;
    max-width: 900px;
    margin-top: 5rem;
    margin-bottom: 5rem;
  }

  @media (max-width: 900px) {
    .blog-content {
      width: 100%;
    }
  }
</style>
