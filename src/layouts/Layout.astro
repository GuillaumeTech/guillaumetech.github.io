74.413C121.903 74.1363 121.931 73.8043 121.986 73.417C122.041 72.9743 122.069 72.3933 122.069 71.674C122.069 67.856 121.045 64.6743 118.998 62.129C117.006 59.5837 113.963 58.311 109.868 58.311C106.714 58.311 103.947 59.2793 101.568 61.216C99.1887 63.0973 97.335 65.7257 96.007 69.101C94.7343 72.4763 94.098 76.405 94.098 80.887Z" fill="${colors.primary}"/></svg>`;

const faviconDataUri = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

const bodyStyle = `--primary-text-color:${colors.primary};--secondary-text-color:${colors.secondary};--background-color:${colors.bg};--accent-color:${colors.accent};`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={faviconDataUri} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Guillaume Técher — Personal website" />
    <title>Guillaume Técher</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Young+Serif&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body style={bodyStyle}>
    <div class="layout-container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }



  html,
  body {
    width: 100%;
    min-height: 100%;
    color: var(--primary-text-color);
    background-color: var(--background-color);
    font-family: "Inter", sans-serif;
  }

a.base-link{
    text-decoration: none;
    color:var(--secondary-text-color);
  }

  .layout-container {
    max-width: 1200px;
    margin: auto;
    padding: 0 80px;
  }

  @media (max-width: 1200px) {
    .layout-container {
      max-width: 1000px;
      margin: auto;
      padding: 0 60px;
    }
  }

  @media (max-width: 600px) {
    .layout-container {
      padding: 0 30px;
    }
  }
</style>
